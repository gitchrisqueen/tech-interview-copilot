# Tech Interview Copilot secrets — TEMPLATE. Copy this file to `.env` and fill in your own keys.
# The real `.env` is git-ignored and never committed. web-server.py injects these values into
# config.js when the browser loads it (keys stay on your machine); log-server.py reads
# TOGETHER_API_KEY from here for the transcription proxy.

# Together AI (https://api.together.ai/settings/api-keys) — hosted transcription (best ASR quality)
TOGETHER_API_KEY=tgp_v1_your-together-key-here

# OpenAI (https://platform.openai.com/api-keys) — optional LLM fallback
OPENAI_API_KEY=sk-your-openai-key-here

# Groq (https://console.groq.com/keys) — optional LLM fallback
GROQ_API_KEY=gsk-your-groq-key-here

# Ollama Cloud (https://ollama.com/settings/keys) — reference only; the app reaches Ollama Cloud
# through the local `ollama serve` bridge, which uses your `ollama signin` session, not this key.
OLLAMA_API_KEY=your-ollama-cloud-key-here
